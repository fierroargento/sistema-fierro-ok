# Identidad del servicio de ensayo
SISTEMA_FIERRO_ENTORNO=staging
SISTEMA_FIERRO_PROPOSITO=uat_desconectada
SISTEMA_FIERRO_RAMA_DESPLIEGUE=integracion-saas-2026-09
MODO_LABORATORIO_DESCONECTADO=true

# Base exclusiva. Reemplazar marcadores en Render; nunca versionar valores reales.
DATABASE_URL=<URL_INTERNA_POSTGRESQL_EXCLUSIVA_DE_STAGING>
BASE_PRODUCTIVA_HUELLA_SHA256=<SHA256_DE_LA_URL_PRODUCTIVA>
BASE_PRODUCTIVA_IDENTIDADES_SHA256=<SHA256_CANONICO_RECURSO_BASE_USUARIO_PRODUCTIVOS>
SISTEMA_FIERRO_COMMIT_ESPERADO=<COMMIT_EXACTO_A_DESPLEGAR>
STAGING_DATABASE_MARKER=<IDENTIFICADOR_ALEATORIO_EXCLUSIVO_DE_AL_MENOS_32_CARACTERES>
SECRET_KEY=<SECRETO_EXCLUSIVO_DE_AL_MENOS_32_CARACTERES>

# Archivos exclusivos del laboratorio (disco persistente separado)
ALMACENAMIENTO_ARCHIVOS=local_aislado
STAGING_UPLOAD_ROOT=/var/data/sistema-fierro-staging

# Todas las fronteras permanecen cerradas durante UAT
CONEXIONES_EXTERNAS_HABILITADAS=false
EFECTOS_EXTERNOS_HABILITADOS=false
WEBHOOKS_HABILITADOS=false
SCHEDULER_ENABLED=false
BOOTSTRAP_BASE_DATOS_HABILITADO=false
OPERACIONES_MASIVAS_HABILITADAS=false
IA_AUTO_RESPUESTA=0
WHATSAPP_CONEXION_HABILITADA=false
WHATSAPP_EFECTOS_HABILITADOS=false
TRACKING_CONEXION_HABILITADA=false
CLOUDINARY_CONEXION_HABILITADA=false
CLOUDINARY_EFECTOS_HABILITADOS=false

# Referencias preparatorias para salida WhatsApp multicuenta.
# No completar durante UAT desconectada. El sufijo exacto se obtiene con
# services.whatsapp_salida_tenant.nombres_variables_credencial(phone_number_id)
# y services.whatsapp_entrada_tenant.nombres_variables_entrada(phone_number_id).
# WHATSAPP_TOKEN_<PHONE_NORMALIZADO>_<HUELLA12>=<TOKEN_EXCLUSIVO_DE_LA_CUENTA>
# WHATSAPP_VERIFY_TOKEN_<PHONE_NORMALIZADO>_<HUELLA12>=<VERIFY_TOKEN_EXCLUSIVO>
# WHATSAPP_APP_SECRET_<PHONE_NORMALIZADO>_<HUELLA12>=<APP_SECRET_EXCLUSIVO>
